# Use a development copy; never use real client data during testing.
APP_ENV=development
ALLOW_PRODUCTION_SHEET=false
APP_TIMEZONE=America/New_York
SHEET_TIMEZONE=America/Los_Angeles
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
DATABASE_URL=
AUTH_URL=http://localhost:3000
INITIAL_ADMIN_EMAILS=

# Gmail SMTP (no domain needed). Set Google 2-Step Verification and an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_APP_PASSWORD=

# Optional alternative: Resend via a verified sender domain; only server-side.
RESEND_API_KEY=
NOTIFY_FROM=
NOTIFY_ADMIN_EMAIL=
# 32+ character random secret for POST /api/cron/notifications
CRON_SECRET=
# Optional protected dependency readiness endpoint; recommended for production.
READINESS_TOKEN=
