# Use a development copy; never use real client data during testing.
APP_ENV=development
ALLOW_PRODUCTION_SHEET=false
APP_TIMEZONE=America/New_York
SHEET_TIMEZONE=America/Los_Angeles
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
DATABASE_URL=
AUTH_URL=http://localhost:3000
INITIAL_ADMIN_EMAILS=

# Optional transactional email via verified sender domain; only server-side.
RESEND_API_KEY=
NOTIFY_FROM=
NOTIFY_ADMIN_EMAIL=
# 32+ character random secret for POST /api/cron/notifications
CRON_SECRET=
